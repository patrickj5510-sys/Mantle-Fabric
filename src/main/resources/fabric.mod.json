{
  "schemaVersion": 1,
  "id": "mantle",
  "version": "${version}",
  "name": "Mantle",
  "description": "Shared code for Slime Knights mods and others.",
  "authors": ["Slime Knights", "AlphaMode"],
  "contact": {
    "sources": "https://github.com/patrickj5510-sys/Mantle-Fabric"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["slimeknights.mantle.Mantle"],
    "client": ["slimeknights.mantle.client.ClientEvents"],
    "fabric-datagen": ["slimeknights.mantle.MantleData"],
    "cardinal-components": ["slimeknights.mantle.util.OffhandCooldownTracker"],
    "rei_client": ["slimeknights.mantle.plugin.rei.REIPlugin"],
    "jei_mod_plugin": ["slimeknights.mantle.plugin.jei.JEIPlugin"]
  },
  "accessWidener": "mantle.accesswidener",
  "mixins": ["mantle.mixins.json"],
  "custom": {
    "cardinal-components": ["mantle:offhand_cooldown"]
  },
  "depends": {
    "minecraft": ">=${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "porting_lib_attributes": ">=${port_lib_attributes_version}",
    "porting_lib_base": ">=${port_lib_base_version}",
    "porting_lib_common": ">=${port_lib_common_version}",
    "porting_lib_config": ">=${port_lib_config_version}",
    "porting_lib_core": ">=${port_lib_core_version}",
    "porting_lib_entity": ">=${port_lib_entity_version}",
    "porting_lib_fluids": ">=${port_lib_fluids_version}",
    "porting_lib_model_loader": ">=${port_lib_model_loader_version}",
    "porting_lib_networking": ">=${port_lib_networking_version}",
    "porting_lib_tags": ">=${port_lib_tags_version}",
    "porting_lib_transfer": ">=${port_lib_transfer_version}",
    "porting_lib_loot": ">=${port_lib_loot_version}"
  }
}
